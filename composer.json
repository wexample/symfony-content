{
  "name": "wexample/symfony-content",
  "description": "Content management helpers for Symfony",
  "type": "library",
  "license": "MIT",
  "version": "2.0.2",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyContent\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "wexample/symfony-helpers": ">=7.0.0",
    "twig/markdown-extra": "^3.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ]
}