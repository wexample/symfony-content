{
  "name": "wexample/symfony-content",
  "description": "Content management helpers for Symfony",
  "type": "library",
  "license": "MIT",
  "version": "3.0.0",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyContent\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=9.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}